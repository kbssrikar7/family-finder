@@ -0,0 +1,16 @@
+package app.mygrid.grid
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import io.rezivure.libre_location.BootReceiver
+
+// An app update kills the location service, and libre_location only restarts
+// tracking on boot. Reuse that path (still gated on startOnBoot) so sharing
+// resumes after an update without the user reopening the app.
+class PackageReplacedReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent?) {
+        if (intent?.action != Intent.ACTION_MY_PACKAGE_REPLACED) return
+        BootReceiver().onReceive(context, Intent(Intent.ACTION_BOOT_COMPLETED))
+    }
+}
