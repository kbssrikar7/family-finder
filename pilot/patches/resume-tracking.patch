@@ -0,0 +1,17 @@
+package app.mygrid.grid
+
+import android.app.Application
+import io.flutter.FlutterInjector
+
+class GridApplication : Application() {
+    override fun onCreate() {
+        super.onCreate()
+        // libre_location's headless dispatcher resolves its Dart callback before
+        // initializing the Flutter loader. When a boot or update broadcast starts
+        // the process (no activity), that throws UnsatisfiedLinkError and crashes
+        // the app, so load Flutter's native library before any dispatch.
+        val loader = FlutterInjector.instance().flutterLoader()
+        loader.startInitialization(this)
+        loader.ensureInitializationComplete(this, null)
+    }
+}
