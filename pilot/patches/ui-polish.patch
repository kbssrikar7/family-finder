+  @override
+  Future<LocationUpdate?> getLastKnownPosition() async {
+    try {
+      // maximumAge is in milliseconds; a cached fix of any recent age returns
+      // immediately, otherwise give up quickly rather than wait for GPS.
+      final position = await libre.LibreLocation.getCurrentPosition(
+        accuracy: libre.Accuracy.high,
+        samples: 1,
+        timeout: 2,
+        maximumAge: const Duration(days: 1).inMilliseconds,
+        persist: false,
+      );
+      return _mapPositionToLocationUpdate(position);
+    } catch (e) {
+      print("No last known position: $e");
+      return null;
+    }
+  }
