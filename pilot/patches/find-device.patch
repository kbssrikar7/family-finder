@@ -0,0 +1,49 @@
+package app.mygrid.grid.finddevice
+
+import android.content.Context
+import android.util.Log
+import org.unifiedpush.android.connector.FailedReason
+import org.unifiedpush.android.connector.PushService
+import org.unifiedpush.android.connector.data.PushEndpoint
+import org.unifiedpush.android.connector.data.PushMessage
+
+/**
+ * Receives UnifiedPush events from the distributor (ntfy). Replaces the
+ * unifiedpush_android Flutter service, whose shared call queue is only drained
+ * by the most recently initialized engine and drops messages once that engine
+ * goes away. Here every message goes to [PushDispatcher]'s dedicated engine.
+ */
+class GridPushService : PushService() {
+    override fun onNewEndpoint(endpoint: PushEndpoint, instance: String) {
+        Log.d(TAG, "New push endpoint registered")
+        prefs(this).edit()
+            .putString(KEY_ENDPOINT, endpoint.url)
+            .remove(KEY_FAILURE)
+            .apply()
+    }
+
+    override fun onMessage(message: PushMessage, instance: String) {
+        Log.d(TAG, "Push message received (${message.content.size} bytes)")
+        PushDispatcher.dispatch(this, String(message.content, Charsets.UTF_8))
+    }
+
+    override fun onRegistrationFailed(reason: FailedReason, instance: String) {
+        Log.w(TAG, "Push registration failed: $reason")
+        prefs(this).edit().putString(KEY_FAILURE, reason.name).apply()
+    }
+
+    override fun onUnregistered(instance: String) {
+        Log.w(TAG, "Push unregistered by distributor")
+        prefs(this).edit().remove(KEY_ENDPOINT).apply()
+    }
+
+    companion object {
+        private const val TAG = "GridPushService"
+        private const val PREFS = "find_device_push"
+        const val KEY_ENDPOINT = "endpoint"
+        const val KEY_FAILURE = "failure"
+
+        fun prefs(context: Context) =
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    }
+}
diff --git a/android/app/src/main/kotlin/app/mygrid/grid/finddevice/PushDispatcher.kt b/android/app/src/main/kotlin/app/mygrid/grid/finddevice/PushDispatcher.kt
new file mode 100644
index 0000000..a262074
--- /dev/null
+++ b/android/app/src/main/kotlin/app/mygrid/grid/finddevice/PushDispatcher.kt
@@ -0,0 +1,108 @@
+package app.mygrid.grid.finddevice
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import io.flutter.FlutterInjector
+import io.flutter.embedding.engine.FlutterEngine
+import io.flutter.embedding.engine.dart.DartExecutor
+import io.flutter.plugin.common.MethodChannel
+
+/**
+ * Hands push payloads to a long-lived headless Flutter engine that runs
+ * `findDevicePushMain` (lib/services/find_device/push_background.dart).
+ * Payloads are queued until the Dart side reports ready, so a push that
+ * starts the process is not lost while the engine boots.
+ */
+object PushDispatcher {
+    private const val TAG = "FindDevicePush"
+    private const val ENTRYPOINT_LIBRARY =
+        "package:grid_frontend/services/find_device/push_background.dart"
+    private const val ENTRYPOINT = "findDevicePushMain"
+
+    private val main = Handler(Looper.getMainLooper())
+    private val pending = mutableListOf<String>()
+    private val pendingCalls = mutableListOf<Call>()
+    private var engine: FlutterEngine? = null
+    private var channel: MethodChannel? = null
+    private var ready = false
+    /** The UI engine's channel while its push handler is listening. */
+    private var mainEngine: MethodChannel? = null
+
+    fun setMainEngine(channel: MethodChannel?) {
+        main.post { mainEngine = channel }
+    }
+
+    fun dispatch(context: Context, payload: String) {
+        main.post {
+            val ui = mainEngine
+            when {
+                ui != null -> ui.invokeMethod("onPush", pushArgs(payload))
+                ready -> deliver(payload)
+                else -> {
+                    pending.add(payload)
+                    ensureEngine(context.applicationContext)
+                }
+            }
+        }
+    }
+
+    /** Called by the Dart entrypoint once its handler is registered. */
+    fun onDartReady() {
+        main.post {
+            ready = true
+            Log.d(TAG, "Push handler ready; delivering ${pending.size} queued")
+            pending.forEach { deliver(it) }
+            pending.clear()
+            pendingCalls.forEach { deliver(it) }
+            pendingCalls.clear()
+        }
+    }
+
+    /** Asks the push handler engine to tell the requester the alarm stopped. */
+    fun reportAlarmStopped(context: Context, roomId: String, requestId: String, reason: String) {
+        dispatchCall(context, Call("onAlarmStopped", mapOf(
+            "roomId" to roomId, "requestId" to requestId, "reason" to reason,
+        )))
+    }
+
+    private fun pushArgs(payload: String) = mapOf(
+        "payload" to payload,
+        "appInForeground" to AppVisibility.isForeground,
+    )
+
+    private fun deliver(payload: String) = deliver(Call("onPush", pushArgs(payload)))
+
+    private fun deliver(call: Call) {
+        channel?.invokeMethod(call.method, call.args)
+    }
+
+    private fun dispatchCall(context: Context, call: Call) {
+        main.post {
+            val ui = mainEngine
+            if (ui != null) ui.invokeMethod(call.method, call.args)
+            else if (ready) deliver(call) else {
+                pendingCalls.add(call)
+                ensureEngine(context.applicationContext)
+            }
+        }
+    }
+
+    private data class Call(val method: String, val args: Map<String, Any?>)
+
+    private fun ensureEngine(context: Context) {
+        if (engine != null) return
+        Log.d(TAG, "Starting push handler engine")
+        val loader = FlutterInjector.instance().flutterLoader()
+        loader.startInitialization(context)
+        loader.ensureInitializationComplete(context, null)
+        val newEngine = FlutterEngine(context)
+        newEngine.plugins.add(FindDevicePlugin())
+        channel = MethodChannel(newEngine.dartExecutor.binaryMessenger, FindDevicePlugin.CHANNEL)
+        engine = newEngine
+        newEngine.dartExecutor.executeDartEntrypoint(
+            DartExecutor.DartEntrypoint(loader.findAppBundlePath(), ENTRYPOINT_LIBRARY, ENTRYPOINT)
+        )
+    }
+}
