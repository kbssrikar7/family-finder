+ * Loud "find my phone" alarm, modeled on Samsung Find's ring operation:
+ * plays the alarm tone on the alarm stream at maximum volume (audible in
+ * silent/vibrate mode), vibrates, and shows a notification to stop it.
+ * The previous alarm volume is restored when it stops.
+ */
+object DeviceAlarm {
+    private const val TAG = "FindDeviceAlarm"
+    private const val CHANNEL_ID = "find_device_alarm"
+    private const val NOTIFICATION_ID = 0x46494e44 // "FIND"
+    private const val MAX_DURATION_MS = 2 * 60 * 1000L
+    const val ACTION_STOP = "app.familyfinder.gridpilot.STOP_FIND_ALARM"
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var player: MediaPlayer? = null
+    private var vibrator: Vibrator? = null
+    private var wakeLock: PowerManager.WakeLock? = null
+    private var savedVolume: Int? = null
+    private var lastRequestId: String? = null
+    private var requestRoomId: String? = null
+    private val autoStop = Runnable { appContext?.let { stop(it, REASON_TIMEOUT) } }
+    private var appContext: Context? = null
+
+    val isRinging: Boolean get() = player != null
+
+    const val REASON_FOUND = "found"
+    const val REASON_TIMEOUT = "timeout"
+    const val REASON_REMOTE = "remote"
+
+    /**
+     * Starts ringing. Returns true only when this call started the alarm, so
+     * exactly one caller acknowledges it; repeats of a request are ignored.
+     */
+    @Synchronized
+    fun start(context: Context, requestId: String, roomId: String, requester: String): Boolean {
+        val ctx = context.applicationContext
+        appContext = ctx
+        if (requestId == lastRequestId) return false
+        lastRequestId = requestId
+        requestRoomId = roomId
+        if (isRinging) {
+            restartTimeout()
+            return true
+        }
+        Log.d(TAG, "Ringing for request $requestId")
+
+        val audio = ctx.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+        savedVolume = audio.getStreamVolume(AudioManager.STREAM_ALARM)
+        try {
+            audio.setStreamVolume(
+                AudioManager.STREAM_ALARM,
+                audio.getStreamMaxVolume(AudioManager.STREAM_ALARM), 0
+            )
+        } catch (e: SecurityException) {
+            Log.w(TAG, "Could not raise alarm volume: ${e.message}")
+        }
+
+        val tone = RingtoneManager.getActualDefaultRingtoneUri(ctx, RingtoneManager.TYPE_ALARM)
+            ?: RingtoneManager.getDefaultUri(RingtoneManager.TYPE_RINGTONE)
+        player = MediaPlayer().apply {
+            setAudioAttributes(
+                AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_ALARM)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                    .build()
+            )
+            setDataSource(ctx, tone)
+            isLooping = true
+            prepare()
+            start()
+        }
+
+        vibrator = (if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            (ctx.getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as VibratorManager).defaultVibrator
+        } else {
+            @Suppress("DEPRECATION")
+            ctx.getSystemService(Context.VIBRATOR_SERVICE) as Vibrator
+        }).also {
+            val pattern = longArrayOf(0, 800, 400)
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                it.vibrate(VibrationEffect.createWaveform(pattern, 0))
+            } else {
+                @Suppress("DEPRECATION")
+                it.vibrate(pattern, 0)
+            }
+        }
+
+        wakeLock = (ctx.getSystemService(Context.POWER_SERVICE) as PowerManager)
+            .newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "gridpilot:find-alarm")
+            .also { it.acquire(MAX_DURATION_MS + 5_000) }
+
+        showNotification(ctx, requester)
+        restartTimeout()
+        return true
+    }
+
+    /** Stops ringing and reports [reason] to the requester via the push handler. */
+    @Synchronized
+    fun stop(context: Context, reason: String) {
+        val ctx = context.applicationContext
+        val wasRinging = isRinging
+        handler.removeCallbacks(autoStop)
+        player?.run {
+            try { stop() } catch (_: IllegalStateException) {}
+            release()
+        }
+        player = null
+        vibrator?.cancel()
+        vibrator = null
+        savedVolume?.let {
+            val audio = ctx.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+            try { audio.setStreamVolume(AudioManager.STREAM_ALARM, it, 0) } catch (_: SecurityException) {}
+        }
+        savedVolume = null
+        wakeLock?.let { if (it.isHeld) it.release() }
+        wakeLock = null
+        (ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager)
+            .cancel(NOTIFICATION_ID)
+        Log.d(TAG, "Alarm stopped ($reason)")
+        val roomId = requestRoomId
+        val requestId = lastRequestId
+        if (wasRinging && roomId != null && requestId != null && reason != REASON_REMOTE) {
+            PushDispatcher.reportAlarmStopped(ctx, roomId, requestId, reason)
+        }
+    }
+
+    private fun restartTimeout() {
+        handler.removeCallbacks(autoStop)
+        handler.postDelayed(autoStop, MAX_DURATION_MS)
+    }
+
+    private fun showNotification(ctx: Context, requester: String) {
+        val manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O &&
+            manager.getNotificationChannel(CHANNEL_ID) == null) {
+            manager.createNotificationChannel(
+                NotificationChannel(CHANNEL_ID, "Find this phone", NotificationManager.IMPORTANCE_HIGH).apply {
+                    description = "Shown while a family member is ringing this phone"
+                    setSound(null, null) // the alarm itself provides the sound
+                    enableVibration(false)
+                }
+            )
+        }
+        val flags = PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        val stop = PendingIntent.getBroadcast(
+            ctx, 0, Intent(ctx, StopReceiver::class.java).setAction(ACTION_STOP), flags
+        )
+        val builder = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            Notification.Builder(ctx, CHANNEL_ID)
+        } else {
+            @Suppress("DEPRECATION")
+            Notification.Builder(ctx).setPriority(Notification.PRIORITY_MAX)
+        }
+        val notification = builder
+            .setSmallIcon(android.R.drawable.ic_lock_idle_alarm)
+            .setContentTitle("Ringing this phone")
+            .setContentText("$requester is trying to find this phone. Tap to stop.")
+            .setCategory(Notification.CATEGORY_ALARM)
+            .setVisibility(Notification.VISIBILITY_PUBLIC)
+            .setOngoing(true)
+            .setContentIntent(stop)
+            .addAction(Notification.Action.Builder(null, "Found it", stop).build())
+            .setDeleteIntent(stop)
+            .build()
+        try {
+            manager.notify(NOTIFICATION_ID, notification)
+        } catch (e: SecurityException) {
+            Log.w(TAG, "Notification permission missing; alarm still rings: ${e.message}")
+        }
+    }
+
+    class StopReceiver : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent?) {
+            if (intent?.action == ACTION_STOP) stop(context, REASON_FOUND)
+        }
+    }
+}
diff --git a/android/app/src/main/kotlin/app/mygrid/grid/finddevice/FindDevicePlugin.kt b/android/app/src/main/kotlin/app/mygrid/grid/finddevice/FindDevicePlugin.kt
