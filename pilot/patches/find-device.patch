+import 'package:flutter_test/flutter_test.dart';
+import 'package:grid_frontend/services/find_device/device_commands.dart';
+import 'package:matrix/matrix.dart';
+import 'package:mocktail/mocktail.dart';
+
+class MockRoom extends Mock implements Room {}
+
+Room _room() {
+  final room = MockRoom();
+  when(() => room.id).thenReturn('!room:localhost');
+  return room;
+}
+
+Event _status(String sender, String state, DateTime at) => Event(
+      content: {
+        'msgtype': DeviceCommands.ringStatusMsgtype,
+        'state': state,
+        'request_id': r'$req',
+      },
+      type: EventTypes.Message,
+      eventId: r'$evt',
+      senderId: sender,
+      originServerTs: at,
+      room: _room(),
+    );
+
+void main() {
+  setUp(() => DeviceCommands.ringStatus.value = {});
+
+  test('records the latest ring status per contact', () {
+    DeviceCommands.handleStatus(_status('@b:localhost', 'ringing', DateTime.now()));
+    DeviceCommands.handleStatus(_status('@b:localhost', 'found', DateTime.now()));
+    expect(DeviceCommands.ringStatus.value['@b:localhost']?.state, 'found');
+  });
+
+  test('ignores stale statuses and other message types', () {
+    DeviceCommands.handleStatus(_status(
+        '@b:localhost', 'ringing', DateTime.now().subtract(const Duration(hours: 1))));
+    final other = _status('@b:localhost', 'ringing', DateTime.now())
+      ..content['msgtype'] = 'm.location';
+    DeviceCommands.handleStatus(other);
+    expect(DeviceCommands.ringStatus.value, isEmpty);
+  });
+}
