@@ -0,0 +1,93 @@
+package app.mygrid.grid.finddevice
+
+import android.content.Context
+import io.flutter.embedding.engine.plugins.FlutterPlugin
+import io.flutter.plugin.common.MethodCall
+import io.flutter.plugin.common.MethodChannel
+import org.unifiedpush.android.connector.UnifiedPush
+
+/**
+ * Platform side of lib/services/find_device/find_device_channel.dart:
+ * push registration via the installed UnifiedPush distributor, and the
+ * ring alarm. Registered on the UI engine and the push handler engine.
+ */
+/**
+ * [isMainEngine] marks the app's UI engine. When its Dart side is listening,
+ * pushes are handled there with the app's own Matrix client; a second client
+ * sending from the same device desynchronizes encryption sessions.
+ */
+class FindDevicePlugin(private val isMainEngine: Boolean = false) :
+    FlutterPlugin, MethodChannel.MethodCallHandler {
+    private var context: Context? = null
+    private var channel: MethodChannel? = null
+
+    override fun onAttachedToEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        context = binding.applicationContext
+        channel = MethodChannel(binding.binaryMessenger, CHANNEL).also {
+            it.setMethodCallHandler(this)
+        }
+    }
+
+    override fun onDetachedFromEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        if (isMainEngine) PushDispatcher.setMainEngine(null)
+        channel?.setMethodCallHandler(null)
+        channel = null
+        context = null
+    }
+
+    override fun onMethodCall(call: MethodCall, result: MethodChannel.Result) {
+        val ctx = context ?: return result.error("NO_CONTEXT", null, null)
+        when (call.method) {
+            "registerPush" -> result.success(registerPush(ctx))
+            "pushStatus" -> {
+                val prefs = GridPushService.prefs(ctx)
+                result.success(mapOf(
+                    "endpoint" to prefs.getString(GridPushService.KEY_ENDPOINT, null),
+                    "failure" to prefs.getString(GridPushService.KEY_FAILURE, null),
+                    "distributor" to UnifiedPush.getAckDistributor(ctx),
+                ))
+            }
+            "startAlarm" -> result.success(
+                DeviceAlarm.start(
+                    ctx,
+                    call.argument<String>("requestId") ?: "",
+                    call.argument<String>("roomId") ?: "",
+                    call.argument<String>("requester") ?: "A family member",
+                )
+            )
+            "stopAlarm" -> {
+                DeviceAlarm.stop(ctx, DeviceAlarm.REASON_REMOTE)
+                result.success(true)
+            }
+            "isAlarmRinging" -> result.success(DeviceAlarm.isRinging)
+            "pushReady" -> {
+                if (isMainEngine) PushDispatcher.setMainEngine(channel)
+                else PushDispatcher.onDartReady()
+                result.success(true)
+            }
+            else -> result.notImplemented()
+        }
+    }
+
+    /** Picks a distributor (preferring ntfy) and registers; the endpoint arrives in [GridPushService]. */
+    private fun registerPush(ctx: Context): String? {
+        val distributors = UnifiedPush.getDistributors(ctx)
+        val current = UnifiedPush.getAckDistributor(ctx) ?: UnifiedPush.getSavedDistributor(ctx)
+        val chosen = current?.takeIf { it in distributors }
+            ?: distributors.firstOrNull { it == NTFY } ?: distributors.firstOrNull()
+            ?: return null
+        UnifiedPush.saveDistributor(ctx, chosen)
+        UnifiedPush.register(ctx)
+        return chosen
+    }
+
+    companion object {
+        const val CHANNEL = "app.familyfinder/find_device"
+        private const val NTFY = "io.heckel.ntfy"
+    }
+}
+
+/** Whether MainActivity (the only activity) is visible, for the push handler. */
+object AppVisibility {
+    @Volatile var isForeground = false
+}
