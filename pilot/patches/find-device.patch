+import 'package:flutter_test/flutter_test.dart';
+import 'package:grid_frontend/services/find_device/find_device_router.dart';
+
+void main() {
+  test('parses event_id_only Matrix push payloads', () {
+    final pushed = PushedEvent.parse(
+        '{"notification":{"event_id":"\$e","room_id":"!r:localhost","counts":{"unread":1}}}');
+    expect(pushed?.eventId, r'$e');
+    expect(pushed?.roomId, '!r:localhost');
+  });
+
+  test('rejects payloads without an event reference', () {
+    expect(PushedEvent.parse('{"notification":{"counts":{}}}'), isNull);
+    expect(PushedEvent.parse('not json'), isNull);
+  });
+}
