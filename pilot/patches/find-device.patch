@@ -0,0 +1,234 @@
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:ble_proximity_signal/ble_proximity_signal.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_compass/flutter_compass.dart';
+import 'package:latlong2/latlong.dart';
+import 'package:matrix/matrix.dart';
+import 'package:provider/provider.dart';
+
+import '../../providers/user_location_provider.dart';
+import '../../services/avatar_announcement_service.dart';
+import '../../services/find_device/device_commands.dart';
+import '../../services/location_manager.dart';
+
+/// Points the way to a contact's phone, like Samsung Find / Find My:
+/// an arrow and distance from GPS + compass while far away, then Bluetooth
+/// signal strength ("Search nearby") and a loud ring for the last metres.
+/// While open, the contact's phone is asked for its location every
+/// [_refresh] and to broadcast a one-time Bluetooth token.
+class FindDeviceScreen extends StatefulWidget {
+  final Room room;
+  final String userId;
+  final String displayName;
+
+  const FindDeviceScreen({
+    super.key,
+    required this.room,
+    required this.userId,
+    required this.displayName,
+  });
+
+  @override
+  State<FindDeviceScreen> createState() => _FindDeviceScreenState();
+}
+
+class _FindDeviceScreenState extends State<FindDeviceScreen> {
+  static const _refresh = Duration(seconds: 10);
+  /// Below this, GPS error dominates and the arrow is unreliable.
+  static const _closeRangeMeters = 20.0;
+
+  final _ble = BleProximitySignal();
+  final _token = _randomToken();
+  Timer? _requestTimer;
+  StreamSubscription<CompassEvent>? _compassSub;
+  StreamSubscription<ProximityEvent>? _proximitySub;
+  double? _heading;
+  ProximityEvent? _proximity;
+  String? _bluetoothProblem;
+  bool _ringing = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _compassSub = FlutterCompass.events?.listen((e) {
+      if (mounted) setState(() => _heading = e.heading);
+    });
+    _requestLocation();
+    _requestTimer = Timer.periodic(_refresh, (_) => _requestLocation());
+    _startNearby();
+  }
+
+  @override
+  void dispose() {
+    _requestTimer?.cancel();
+    _compassSub?.cancel();
+    _proximitySub?.cancel();
+    unawaited(_ble.stopScan().catchError((_) {}));
+    unawaited(DeviceCommands.sendNearby(widget.room, token: _token, start: false)
+        .catchError((_) {}));
+    super.dispose();
+  }
+
+  void _requestLocation() {
+    unawaited(AvatarAnnouncementService(widget.room.client)
+        .requestLocations(widget.room.id, userIds: [widget.userId], live: true));
+  }
+
+  Future<void> _startNearby() async {
+    try {
+      if (await _ble.requestPermissions() != BlePermissionStatus.granted) {
+        setState(() => _bluetoothProblem = 'Allow "Nearby devices" to use the signal meter');
+        return;
+      }
+      if (await _ble.checkAvailability() != BleAvailability.ready) {
+        setState(() => _bluetoothProblem = 'Turn on Bluetooth to use the signal meter');
+        return;
+      }
+      _proximitySub = _ble.events.listen((e) {
+        if (mounted) setState(() => _proximity = e);
+      });
+      await _ble.startScan(
+        targetTokens: [_token],
+        config: const ScanConfig(serviceUuid: DeviceCommands.nearbyServiceUuid),
+      );
+      await DeviceCommands.sendNearby(widget.room, token: _token, start: true);
+    } catch (e) {
+      print('[FindDevice] Nearby scan failed: $e');
+      if (mounted) setState(() => _bluetoothProblem = 'Signal meter unavailable');
+    }
+  }
+
+  Future<void> _toggleRing() async {
+    final start = !_ringing;
+    setState(() => _ringing = start);
+    await DeviceCommands.sendRing(widget.room, start: start);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final mine = context.watch<LocationManager>().currentLatLng;
+    final theirs = context.watch<UserLocationProvider>().getUserLocation(widget.userId);
+    final target = theirs == null ? null : LatLng(theirs.latitude, theirs.longitude);
+    final updated = theirs == null ? null : DateTime.tryParse(theirs.timestamp);
+    final colors = Theme.of(context).colorScheme;
+
+    double? meters;
+    double? bearing;
+    if (mine != null && target != null) {
+      meters = const Distance().as(LengthUnit.Meter, mine, target);
+      bearing = const Distance().bearing(mine, target);
+    }
+    final close = meters != null && meters < _closeRangeMeters;
+
+    return Scaffold(
+      appBar: AppBar(title: Text('Find ${widget.displayName}')),
+      body: SafeArea(
+        child: Padding(
+          padding: const EdgeInsets.all(24),
+          child: Column(
+            children: [
+              const Spacer(),
+              _buildArrow(colors, bearing, close),
+              const SizedBox(height: 24),
+              Text(
+                meters == null
+                    ? 'Waiting for location…'
+                    : close
+                        ? 'Very close'
+                        : _formatDistance(meters),
+                style: Theme.of(context).textTheme.displaySmall,
+              ),
+              const SizedBox(height: 8),
+              Text(
+                _statusLine(close, updated),
+                textAlign: TextAlign.center,
+                style: TextStyle(color: colors.onSurfaceVariant),
+              ),
+              const Spacer(),
+              _buildSignal(colors),
+              const SizedBox(height: 24),
+              SizedBox(
+                width: double.infinity,
+                child: FilledButton.icon(
+                  onPressed: _toggleRing,
+                  icon: Icon(_ringing
+                      ? Icons.volume_off_rounded
+                      : Icons.notifications_active_rounded),
+                  label: Text(_ringing ? 'Stop sound' : 'Play sound'),
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  String _statusLine(bool close, DateTime? updated) {
+    if (_heading == null && !close) return 'Compass unavailable — the arrow is relative to north';
+    final age = updated == null ? null : DateTime.now().difference(updated);
+    final when = age == null
+        ? ''
+        : age.inSeconds < 60
+            ? 'Updated ${age.inSeconds}s ago'
+            : 'Updated ${age.inMinutes} min ago';
+    return close ? 'Use the signal below or play a sound. $when' : 'Hold your phone flat. $when';
+  }
+
+  Widget _buildArrow(ColorScheme colors, double? bearing, bool close) {
+    if (bearing == null || close) {
+      return Icon(Icons.my_location_rounded, size: 160, color: colors.primary);
+    }
+    // Arrow points at the target relative to where the phone is facing.
+    final angle = (bearing - (_heading ?? 0)) * math.pi / 180;
+    return Transform.rotate(
+      angle: angle,
+      child: Icon(Icons.navigation_rounded, size: 200, color: colors.primary),
+    );
+  }
+
+  Widget _buildSignal(ColorScheme colors) {
+    final p = _proximity;
+    final stale = p == null || DateTime.now().difference(p.timestamp) > const Duration(seconds: 8);
+    final label = _bluetoothProblem ??
+        (stale
+            ? 'Searching for their phone nearby…'
+            : switch (p.level) {
+                ProximityLevel.veryNear => 'Very near — within a few metres',
+                ProximityLevel.near => 'Near — getting warmer',
+                ProximityLevel.far => 'In range — keep moving',
+              });
+    return Column(
+      children: [
+        Row(
+          children: [
+            Icon(Icons.bluetooth_searching_rounded, color: colors.primary),
+            const SizedBox(width: 8),
+            Expanded(child: Text(label)),
+          ],
+        ),
+        const SizedBox(height: 8),
+        ClipRRect(
+          borderRadius: BorderRadius.circular(8),
+          child: LinearProgressIndicator(
+            value: stale ? 0 : p.intensity.clamp(0.0, 1.0),
+            minHeight: 12,
+            color: colors.primary,
+            backgroundColor: colors.surfaceContainerHighest,
+          ),
+        ),
+      ],
+    );
+  }
+
+  static String _formatDistance(double meters) => meters < 1000
+      ? '${meters.round()} m'
+      : '${(meters / 1000).toStringAsFixed(meters < 10000 ? 1 : 0)} km';
+
+  static String _randomToken() {
+    final random = math.Random.secure();
+    return List.generate(8, (_) => random.nextInt(256).toRadixString(16).padLeft(2, '0')).join();
+  }
+}
diff --git a/lib/services/find_device/device_commands.dart b/lib/services/find_device/device_commands.dart
new file mode 100644
index 0000000..e2983c7
--- /dev/null
+++ b/lib/services/find_device/device_commands.dart
@@ -0,0 +1,179 @@
+import 'dart:async';
+
+import 'package:ble_proximity_signal/ble_proximity_signal.dart';
+import 'package:flutter/foundation.dart';
+import 'package:matrix/matrix.dart';
+
+import 'find_device_channel.dart';
+
+/// Find-device commands, sent as (end-to-end encrypted) messages in the
+/// direct room shared by two contacts — the Matrix counterpart of Samsung
+/// Find's `/devices/{id}/operation/{type}` calls. Room membership is the
+/// authorization: only a contact you share a direct room with can ring you.
+class DeviceCommands {
+  static const ringMsgtype = 'm.device.ring';
+  static const ringStatusMsgtype = 'm.device.ring.status';
+
+  /// Asks the phone to broadcast a one-time Bluetooth token so the finder can
+  /// measure proximity (Samsung Find's "Search nearby" on non-UWB phones).
+  static const nearbyMsgtype = 'm.device.nearby';
+  static const maxBroadcast = Duration(minutes: 5);
+  static final _ble = BleProximitySignal();
+
+  /// 16-bit-form service UUID (Bluetooth base UUID). The plugin's default
+  /// 128-bit UUID plus service data is 47 bytes, over the 31-byte legacy
+  /// advertisement limit, so advertising failed with DATA_TOO_LARGE.
+  static const nearbyServiceUuid = '0000ffe7-0000-1000-8000-00805f9b34fb';
+  static Timer? _broadcastTimeout;
+
+  /// Latest ring status reported by each contact's phone, for the finder UI.
+  static final ringStatus = ValueNotifier<Map<String, RingStatus>>({});
+
+  /// Commands older than this are ignored, so a phone that comes back online
+  /// does not ring for a request made long ago.
+  static const maxCommandAge = Duration(minutes: 2);
+
+  static Future<void> sendNearby(Room room, {required String token, required bool start}) async {
+    await room.sendEvent({
+      'msgtype': nearbyMsgtype,
+      'body': start ? 'Finding your phone nearby' : 'Stopped nearby search',
+      'action': start ? 'start' : 'stop',
+      'token': token,
+    });
+  }
+
+  static Future<void> sendRing(Room room, {required bool start}) async {
+    await room.sendEvent({
+      'msgtype': ringMsgtype,
+      'body': start ? 'Ringing your phone' : 'Stopped ringing',
+      'action': start ? 'start' : 'stop',
+    });
+  }
+
+  /// Acts on a decrypted ring command. Returns true when it was a ring command.
+  static Future<bool> handle(Event event, Room room, String? myUserId) async {
+    final msgtype = event.content['msgtype'];
+    if (msgtype != ringMsgtype && msgtype != nearbyMsgtype) return false;
+    if (event.senderId == myUserId) return true;
+    if (DateTime.now().difference(event.originServerTs) > maxCommandAge) {
+      print('[FindDevice] Ignoring stale ring command ${event.eventId}');
+      return true;
+    }
+    if (!await _isDirectContact(room, event.senderId, myUserId)) {
+      print('[FindDevice] Ignoring ring from non-contact ${event.senderId}');
+      return true;
+    }
+    if (msgtype == nearbyMsgtype) {
+      await _handleNearby(event);
+    } else if (event.content['action'] == 'stop') {
+      await FindDeviceChannel.stopAlarm();
+    } else {
+      final sender = room.unsafeGetUserFromMemoryOrFallback(event.senderId);
+      final started = await FindDeviceChannel.startAlarm(
+        requestId: event.eventId,
+        roomId: room.id,
+        requester: sender.calcDisplayname(),
+      );
+      if (started) await sendStatus(room, event.eventId, 'ringing');
+    }
+    return true;
+  }
+
+  static StreamSubscription<ProximityEvent>? _broadcastErrors;
+
+  static Future<void> _handleNearby(Event event) async {
+    // Advertising failures are only reported on the events stream.
+    _broadcastErrors ??= _ble.events.listen((_) {}, onError: (Object e) {
+      print('[FindDevice] Nearby broadcast error: $e');
+    });
+    _broadcastTimeout?.cancel();
+    try {
+      await _ble.stopBroadcast();
+    } catch (_) {}
+    final token = event.content['token'];
+    if (event.content['action'] != 'start' || token is! String) return;
+    try {
+      if (await _ble.checkPermissions() != BlePermissionStatus.granted) {
+        print('[FindDevice] Nearby: Bluetooth permission not granted');
+        return;
+      }
+      await _ble.startBroadcast(
+        token: token,
+        config: const BroadcastConfig(
+            serviceUuid: nearbyServiceUuid, txPower: 3 /* high, for range */),
+      );
+      _broadcastTimeout = Timer(maxBroadcast, () => _ble.stopBroadcast());
+      print('[FindDevice] Broadcasting nearby token');
+    } catch (e) {
+      print('[FindDevice] Nearby broadcast failed: $e');
+    }
+  }
+
+  /// Bluetooth permission is needed in advance: a lost phone cannot show a
+  /// permission prompt. Asked once when the app opens.
+  static Future<void> ensureNearbyPermission() async {
+    try {
+      if (await _ble.checkPermissions() != BlePermissionStatus.granted) {
+        await _ble.requestPermissions();
+      }
+    } catch (e) {
+      print('[FindDevice] Bluetooth permission request failed: $e');
+    }
+  }
+
+  /// Tells the requester whether the phone is ringing or why it stopped
+  /// (`found`, `timeout`) — like Samsung Find's ring state.
+  static Future<void> sendStatus(Room room, String requestId, String state) async {
+    try {
+      await room.sendEvent({
+        'msgtype': ringStatusMsgtype,
+        'body': 'Ring status: $state',
+        'state': state,
+        'request_id': requestId,
+      });
+    } catch (e) {
+      print('[FindDevice] Could not send ring status: $e');
+    }
+  }
+
+  /// Finder side: records a contact's reported ring status.
+  static void handleStatus(Event event) {
+    if (event.content['msgtype'] != ringStatusMsgtype) return;
+    if (DateTime.now().difference(event.originServerTs) > maxCommandAge * 2) return;
+    final state = event.content['state'];
+    if (state is! String) return;
+    ringStatus.value = {
+      ...ringStatus.value,
+      event.senderId: RingStatus(state, event.originServerTs),
+    };
+  }
+
+  /// Server-authoritative check that [sender] and [me] are both joined to a
+  /// Grid direct room; a background engine's cached room state may be stale.
+  static Future<bool> _isDirectContact(Room room, String sender, String? me) async {
+    if (me == null) return false;
+    final client = room.client;
+    try {
+      final nameState =
+          await client.getRoomStateWithKey(room.id, EventTypes.RoomName, '');
+      final name = nameState['name'];
+      if (name is! String || !name.startsWith('Grid:Direct:')) return false;
+      for (final user in {sender, me}) {
+        final member =
+            await client.getRoomStateWithKey(room.id, EventTypes.RoomMember, user);
+        if (member['membership'] != Membership.join.name) return false;
+      }
+      return true;
+    } catch (e) {
+      print('[FindDevice] Membership check failed: $e');
+      return false;
+    }
+  }
+}
+
+class RingStatus {
+  /// `ringing`, `found` or `timeout`.
+  final String state;
+  final DateTime at;
+  const RingStatus(this.state, this.at);
+}
diff --git a/lib/services/find_device/find_device_channel.dart b/lib/services/find_device/find_device_channel.dart
new file mode 100644
index 0000000..b327419
--- /dev/null
+++ b/lib/services/find_device/find_device_channel.dart
@@ -0,0 +1,62 @@
+import 'package:flutter/services.dart';
+
+/// Dart side of android/.../finddevice/FindDevicePlugin.kt.
+class FindDeviceChannel {
+  static const _channel = MethodChannel('app.familyfinder/find_device');
+
+  /// Registers with the installed UnifiedPush distributor. Returns the
+  /// distributor package, or null when none is installed.
+  static Future<String?> registerPush() =>
+      _channel.invokeMethod<String>('registerPush');
+
+  static Future<PushStatus> pushStatus() async {
+    final map = await _channel.invokeMapMethod<String, dynamic>('pushStatus') ?? {};
+    return PushStatus(
+      endpoint: map['endpoint'] as String?,
+      failure: map['failure'] as String?,
+      distributor: map['distributor'] as String?,
+    );
+  }
+
+  /// Returns true only when this call started ringing (acknowledge once).
+  static Future<bool> startAlarm({
+    required String requestId,
+    required String roomId,
+    required String requester,
+  }) async =>
+      await _channel.invokeMethod<bool>('startAlarm',
+          {'requestId': requestId, 'roomId': roomId, 'requester': requester}) ??
+      false;
+
+  static Future<void> stopAlarm() => _channel.invokeMethod('stopAlarm');
+
+  static Future<bool> isAlarmRinging() async =>
+      await _channel.invokeMethod<bool>('isAlarmRinging') ?? false;
+
+  /// Push handler engine only: route pushes to [onPush], then tell native to
+  /// release queued payloads.
+  static Future<void> listenForPushes(
+    Future<void> Function(String payload, bool appInForeground) onPush, {
+    required Future<void> Function(String roomId, String requestId, String reason)
+        onAlarmStopped,
+  }) async {
+    _channel.setMethodCallHandler((call) async {
+      final args = Map<String, dynamic>.from(call.arguments as Map);
+      if (call.method == 'onPush') {
+        await onPush(args['payload'] as String, args['appInForeground'] as bool? ?? false);
+      } else if (call.method == 'onAlarmStopped') {
+        await onAlarmStopped(
+            args['roomId'] as String, args['requestId'] as String, args['reason'] as String);
+      }
+      return null;
+    });
+    await _channel.invokeMethod('pushReady');
+  }
+}
+
+class PushStatus {
+  final String? endpoint;
+  final String? failure;
+  final String? distributor;
+  const PushStatus({this.endpoint, this.failure, this.distributor});
+}
diff --git a/lib/services/find_device/find_device_router.dart b/lib/services/find_device/find_device_router.dart
new file mode 100644
index 0000000..60a04d8
--- /dev/null
+++ b/lib/services/find_device/find_device_router.dart
@@ -0,0 +1,60 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:matrix/matrix.dart';
+
+import '../message_processor.dart';
+import 'device_commands.dart';
+import 'find_device_channel.dart';
+
+/// Event reference carried by a Matrix push in `event_id_only` format.
+class PushedEvent {
+  final String eventId;
+  final String roomId;
+  const PushedEvent(this.eventId, this.roomId);
+
+  static PushedEvent? parse(String payload) {
+    try {
+      final notification = (jsonDecode(payload) as Map)['notification'] as Map?;
+      final eventId = notification?['event_id'];
+      final roomId = notification?['room_id'];
+      if (eventId is String && roomId is String) return PushedEvent(eventId, roomId);
+    } catch (_) {}
+    return null;
+  }
+}
+
+/// Handles pushes in the app's main engine while it is alive, using the app's
+/// own Matrix client and [MessageProcessor] (which decrypts, enforces the
+/// contact/sharing gates, and acts on find-device commands). Only one client
+/// may send from a device: a second one desynchronizes encryption sessions.
+class FindDeviceRouter {
+  static bool _attached = false;
+
+  static Future<void> attachMainEngine(Client client, MessageProcessor processor) async {
+    if (_attached) return;
+    _attached = true;
+    unawaited(DeviceCommands.ensureNearbyPermission());
+    try {
+      await FindDeviceChannel.listenForPushes(
+        (payload, appInForeground) async {
+          final pushed = PushedEvent.parse(payload);
+          if (pushed == null) return;
+          try {
+            final event = await client.getOneRoomEvent(pushed.roomId, pushed.eventId);
+            await processor.processEvent(pushed.roomId, event);
+          } catch (e) {
+            print('[FindDevice] Main engine push handling failed: $e');
+          }
+        },
+        onAlarmStopped: (roomId, requestId, reason) async {
+          final room = client.getRoomById(roomId);
+          if (room != null) await DeviceCommands.sendStatus(room, requestId, reason);
+        },
+      );
+    } catch (e) {
+      _attached = false;
+      print('[FindDevice] Could not attach main engine push handler: $e');
+    }
+  }
+}
diff --git a/lib/services/find_device/push_background.dart b/lib/services/find_device/push_background.dart
new file mode 100644
index 0000000..d351fc2
--- /dev/null
+++ b/lib/services/find_device/push_background.dart
@@ -0,0 +1,85 @@
+import 'dart:ui';
+
+import 'package:flutter/widgets.dart';
+import 'package:libre_location/libre_location.dart' as libre;
+import 'package:matrix/matrix.dart';
+
+import '../android_background_task.dart';
+import 'device_commands.dart';
+import 'find_device_channel.dart';
+import 'find_device_router.dart';
+
+/// Entrypoint of the headless engine started by PushDispatcher.kt for every
+/// UnifiedPush message (a Matrix push with `event_id_only` format). Fetches
+/// and decrypts the event, then acts on find-device commands — even when the
+/// app is closed, like Samsung Find's push-delivered device operations.
+@pragma('vm:entry-point')
+Future<void> findDevicePushMain() async {
+  WidgetsFlutterBinding.ensureInitialized();
+  DartPluginRegistrant.ensureInitialized();
+  print('[FindDevice] Push handler isolate started');
+  await FindDeviceChannel.listenForPushes(_onPush, onAlarmStopped: _onAlarmStopped);
+}
+
+Future<void> _onPush(String payload, bool appInForeground) async {
+  try {
+    final pushed = PushedEvent.parse(payload);
+    if (pushed == null) return;
+    final eventId = pushed.eventId;
+    final roomId = pushed.roomId;
+    print('[FindDevice] Push for event in $roomId');
+
+    final client = await backgroundMatrixClient();
+    if (client == null) return;
+
+    final room = client.getRoomById(roomId) ?? Room(id: roomId, client: client);
+    var event = Event.fromMatrixEvent(await client.getOneRoomEvent(roomId, eventId), room);
+    if (event.type == EventTypes.Encrypted && client.encryption != null) {
+      event = await client.encryption!.decryptRoomEvent(event);
+    }
+    if (event.type != EventTypes.Message) return;
+
+    if (await DeviceCommands.handle(event, room, client.userID)) return;
+
+    // The open app answers location requests itself; answer only when closed.
+    if (!appInForeground && event.content['msgtype'] == 'm.location.request') {
+      await _answerLocationRequest(event, client.userID);
+    }
+  } catch (e, st) {
+    print('[FindDevice] Push handling failed: $e\n$st');
+  }
+}
+
+Future<void> _onAlarmStopped(String roomId, String requestId, String reason) async {
+  final client = await backgroundMatrixClient();
+  final room = client?.getRoomById(roomId);
+  if (room == null) return;
+  await DeviceCommands.sendStatus(room, requestId, reason);
+}
+
+Future<void> _answerLocationRequest(Event event, String? me) async {
+  final requested = event.content['requested_users'];
+  if (requested is List && !requested.contains(me)) return;
+  if (event.senderId == me ||
+      DateTime.now().difference(event.originServerTs) > DeviceCommands.maxCommandAge) {
+    return;
+  }
+  final fix = await libre.LibreLocation.getCurrentPosition(
+    accuracy: libre.Accuracy.high,
+    samples: 1,
+    timeout: 20,
+    maximumAge: 10000,
+    persist: false,
+  );
+  await processBackgroundLocation(
+    fix.latitude,
+    fix.longitude,
+    fix.accuracy,
+    DateTime.now(),
+    fix.isMoving,
+    speed: fix.speed,
+    heading: fix.heading,
+    batteryLevel: fix.battery?.level,
+    isCharging: fix.battery?.isCharging,
+  );
+}
